NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/vitalist
CLIENT_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Patient persona AI via Groq (optional — without a key the patient uses scripted replies)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
PATIENT_MODEL=openai/gpt-oss-120b
PATIENT_REASONING_EFFORT=low

# Seeded faculty admin account
ADMIN_EMAIL=admin@vitalist.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Faculty Admin
